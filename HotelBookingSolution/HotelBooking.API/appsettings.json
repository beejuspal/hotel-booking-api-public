{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=;Initial Catalog=;User ID= ;Password=;Encrypt=True;TrustServerCertificate=True;Connection Timeout=100000;"
  },
  "ApiSettings": {
    "Secret": ".",
    "ExpiryMinutes": "15",

    "validateLifetime": true,
    "Issuer": "hotelbooking-API",
    "Audience": "client-hotelbook"
  },
  "CloudinarySettings": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""

  },
  "Serilog": {
    "MinimumLevel": "Information",
    "Using": [ "Serilog.Filters.Expressions" ],
    "Filter": [
      {
        "Name": "ByIncludingOnly",
        "Args": {
          "expression": "Contains(SourceContext, 'Controller') or Contains(SourceContext, 'Service') or Contains(SourceContext, 'Repository') or Contains(SourceContext, 'ExceptionHandlingMiddleware') or @l = 'Error'"

        }
      }
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/errorLog.txt",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] {SourceContext}{NewLine}{Message}{NewLine}{Exception}{NewLine}",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/response-time-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/slow-api-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  }


}
